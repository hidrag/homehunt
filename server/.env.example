PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/homehunt

# Authentication Secrets (S4)
# Must both be provided and must be distinct
JWT_ACCESS_SECRET=replace_with_a_secure_random_string_minimum_32_characters
JWT_REFRESH_SECRET=replace_with_a_different_secure_random_string_minimum_32_characters

# Email (S8) — 'fake' keeps all email work in-memory for development/tests.
# 'resend' sends real email via the Resend HTTP API (native fetch, no SDK).
EMAIL_PROVIDER=fake
EMAIL_FROM=no-reply@example.com
RESEND_API_KEY=
