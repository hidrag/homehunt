# HomeHunt environment configuration — copy to .env (never commit .env).
# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/homehunt
JWT_ACCESS_SECRET=change-me-access-secret-minimum-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-minimum-32-chars

# S16 (ADR-042) — production hardening knobs (defaults shown)
TRUST_PROXY=1
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=900000
SHUTDOWN_TIMEOUT_MS=8000

# Cloudinary (S13) — optional; UPLOAD_PROVIDER=fake for dev/tests
UPLOAD_PROVIDER=fake
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Email (S8) — optional; EMAIL_PROVIDER=fake for dev/tests
EMAIL_PROVIDER=fake
# EMAIL_FROM=
# RESEND_API_KEY=

# Docker Compose (S16) — used by docker-compose.yml only
# CLIENT_PORT=8080
